# Para la demostración NO necesitas copiar este archivo ni definir variables.
# Solo aplica si quieres personalizar la ejecución local.
SEED_ADMIN_EMAIL=admin@biotest.local
SEED_ADMIN_PASSWORD=BioTest-Local-2026!
BIOTEST_DATA_DIR=./data
PORT=3000

# Opcional: desactiva el botón de acceso de demostración.
# BIOTEST_DEMO_ACCESS=false

# SOLO para un despliegue real con PostgreSQL (todas obligatorias en ese modo):
# BIOTEST_USE_POSTGRES=true
# DATABASE_URL=postgresql://usuario:contraseña@host:5432/base_de_datos?sslmode=require
# DATABASE_SSL=true
# SEED_ADMIN_PASSWORD=<contraseña robusta>
# SESSION_SECRET=<mínimo 32 caracteres aleatorios>
# COOKIE_SECURE=true
